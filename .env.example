# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Required. Server-side SDK key for your LaunchDarkly Test environment
# (Project settings > Environments > Test > SDK key). Starts with "sdk-".
LAUNCHDARKLY_SDK_KEY=

# Part 1 remediation. URL of the flag trigger on eta-predictions with the
# action "Turn the flag off". Treat it like a password.
LD_TRIGGER_URL=

# Optional REST API fallback for scripts/rollback.sh (any flag).
# Access token with a Writer role (Account settings > Authorization).
LD_API_TOKEN=
LD_PROJECT_KEY=abc-freight
LD_ENV_KEY=test

# Optional. Anthropic API key for the dispatcher assistant (AI Configs).
# Without it the assistant runs as a dry run: it shows the model and prompt
# LaunchDarkly serves, calls no model, and costs nothing.
MODEL_API_KEY=

# Optional. Set to true to keep the dry run even with MODEL_API_KEY set,
# for example while rehearsing a demo.
ASSISTANT_DRY_RUN=

# Optional. Where the app listens (python -m app).
HOST=127.0.0.1
PORT=8000
